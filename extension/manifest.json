{
  "manifest_version": 3,
  "name": "Tutor Local (solo lectura)",
  "version": "0.1",
  "description": "Sensor pasivo: envia el texto de la leccion a tu backend local. Nunca hace clic ni navega.",
  "permissions": ["activeTab"],
  "host_permissions": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Tutor Local — Ctrl+Shift+S para resumir" }
}
